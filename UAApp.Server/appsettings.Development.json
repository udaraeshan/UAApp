{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=sql1002.site4now.net;Initial Catalog=db_ab0810_testdb;User Id=db_ab0810_testdb_admin;Password=Admin@123"
  },
  "SMTP": {
    "EmailNotifications": true,
    "Host": "mail.ua.com",
    "From": "ga@ua.com",
    "Alias": "UAApp",
    "Password": "UA@1234",
    "Port": "587"
  },
  "AuthenticationConfig": {
    "Key": "UAApplicationKeyAuthConfig",
    "ExpiresIn": 2592000,
    "TokenID": "0"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Serilog": {
    "Using": [ "SeriLog.Sinks.Console", "Serilog.Sinks.File", "Serilog.Sinks.Async", "Serilog.Sinks.EventLog" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "EventLog",
        "Args": {
          "source": "ORIXAIAPP",
          "restrictedToMinimumLevel": "Information"
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/log.log",
                "rollingInterval": "Day",
                "formatter": "Serilog.Formatting.Json.JsonFormatter"
              }
            }
          ]
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ],
    "Properties": {
      "Application": "ORIXAIAPP",
      "ServerName": "Local-host"
    }
  }
}